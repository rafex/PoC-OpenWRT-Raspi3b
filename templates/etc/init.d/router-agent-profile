#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    RUNTIME=/tmp/router-profile
    [ -x "$RUNTIME/backend" ] || return 0
    [ -s "$RUNTIME/agent_key" ] && [ -s "$RUNTIME/agent_token" ] && [ -s "$RUNTIME/agent_known_hosts" ] || return 1

    procd_open_instance
    procd_set_param command "$RUNTIME/backend"
    procd_set_param env ROUTER_AGENT_LISTEN_ADDR=127.0.0.1:8443
    procd_set_param env "ROUTER_AGENT_API_TOKEN=$(cat "$RUNTIME/agent_token")"
    procd_set_param env ROUTER_AGENT_ALLOWED_CIDRS=127.0.0.1/32
    procd_set_param env ROUTER_AGENT_SSH_HOST=127.0.0.1
    procd_set_param env ROUTER_AGENT_SSH_USER=root
    procd_set_param env "ROUTER_AGENT_SSH_KEY_PATH=$RUNTIME/agent_key"
    procd_set_param env "ROUTER_AGENT_SSH_KNOWN_HOSTS_PATH=$RUNTIME/agent_known_hosts"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
